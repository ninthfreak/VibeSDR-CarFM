{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "ask": [
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-commit.sh\"",
            "timeout": 180,
            "statusMessage": "Verifying before commit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-ledger-check.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
